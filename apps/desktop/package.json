{
  "name": "swingscore-owner-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "SwingScore Owner for Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.swingscore.owner",
    "productName": "SwingScore Owner",
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "SwingScore Owner.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}

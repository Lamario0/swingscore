{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --import=emulator-data --export-on-exit=emulator-data \"tsx watch --clear-screen=false server.ts\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:functions": "esbuild functions/src/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=functions/lib/index.js",
    "deploy": "firebase deploy --only firestore,functions,hosting",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist emulator-data",
    "lint": "tsc --noEmit",
    "test": "firebase emulators:exec --only auth,firestore \"tsx --test tests/scoring.test.ts tests/rules.test.ts tests/api.test.ts\"",
    "gateway:create": "tsx scripts/create-gateway.ts",
    "gateway:import": "tsx scripts/import-data-json.ts",
    "owner:grant": "tsx scripts/grant-owner.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
